# Sunucu portu (varsayılan: 3000)
PORT=3000

# Notların ve proje klasörlerinin saklanacağı dizin (varsayılan: ./data)
DATA_DIR=./data

# Tek kullanıcılı oturum şifresi (boş bırakılırsa şifre sormadan doğrudan açılır)
APP_PASSWORD=

# HTTP-only cookie imzalama anahtarı (APP_PASSWORD aktifken güçlü bir rastgele değer girin)
AUTH_SECRET=
